{
  "name": "@cowok-design/builtin-skills",
  "version": "0.1.0",
  "description": "Built-in harness operating skills conforming to agentskills.io standard with multi-axis capability registry",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
