#!/usr/bin/env bash
# Opt-in Fast Pre-Push Parity Hook (Canary bypass: SKIP_PREPUSH_PARITY=1)
set -euo pipefail

if [ "${SKIP_PREPUSH_PARITY:-0}" = "1" ]; then
  echo "⚠️  SKIP_PREPUSH_PARITY=1 set — bypassing fast pre-push parity check."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "🔍 [pre-push] Running fast parity check (fmt + lockfile + clean shared-types typecheck)..."
node scripts/preflight-pr.mjs --fast
