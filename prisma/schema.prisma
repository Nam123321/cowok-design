model ChangeProposal {
  id                   String   @id @default(uuid())
  tenantId             String   @default("local-default") @map("tenant_id")
  projectId            String   @map("project_id")
  specKey              String   @map("spec_key")
  intentId             String?  @map("intent_id")
  title                String   @default("")
  description          String   @default("")
  filesJson            String   @default("[]") @map("files_json")
  diffContent          String   @map("diff_content")
  status               String   @default("PENDING")
  validationStatus     String   @default("unverified") @map("validation_status")
  validationChecksJson String   @default("[]") @map("validation_checks_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")

  @@index([projectId, updatedAt])
  @@map("change_proposals")
}

model VersionSnapshot {
  id             String   @id @default(uuid())
  tenantId       String   @default("local-default") @map("tenant_id")
  projectId      String   @map("project_id")
  snapshotTag    String   @map("snapshot_tag")
  versionTag     String   @default("") @map("version_tag")
  label          String   @default("")
  description    String   @default("")
  trigger        String   @default("manual")
  treeSha256     String   @default("") @map("tree_sha256")
  filesJson      String   @default("[]") @map("files_json")
  manifestSha256 String   @map("manifest_sha256")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@index([projectId, createdAt])
  @@map("version_snapshots")
}

model GithubPullRequest {
  id         String   @id @default(uuid())
  tenantId   String   @default("local-default") @map("tenant_id")
  projectId  String   @map("project_id")
  prNumber   Int      @map("pr_number")
  branchName String   @map("branch_name")
  title      String
  prUrl      String   @default("") @map("pr_url")
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("github_pull_requests")
}

// ============================================================================
// Bounded Context: presentation-deck (Epic-08)
// ============================================================================

model PresentationDeck {
  id             String  @id @default(uuid())
  projectId      String  @map("project_id")
  title          String
  themePreset    String  @default("DEFAULT") @map("theme_preset")
  slidesCount    Int     @default(0) @map("slides_count")
  lastExportedAt BigInt? @map("last_exported_at")
  updatedAt      BigInt  @map("updated_at")

  slides DeckSlide[]

  @@index([projectId])
  @@map("presentation_decks")
}

model DeckSlide {
  id            String @id @default(uuid())
  deckId        String @map("deck_id")
  slideIndex    Int    @map("slide_index")
  layoutKind    String @default("STANDARD") @map("layout_kind")
  htmlPath      String @map("html_path")
  contentSha256 String @map("content_sha256")
  updatedAt     BigInt @map("updated_at")

  deck         PresentationDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  wordingSlots WordingSlot[]

  @@unique([deckId, slideIndex])
  @@map("deck_slides")
}

model WordingSlot {
  id        String @id @default(uuid())
  slideId   String @map("slide_id")
  ffId      String @map("ff_id")
  slotLabel String @map("slot_label")
  textValue String @map("text_value")
  updatedAt BigInt @map("updated_at")

  slide DeckSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, ffId])
  @@map("wording_slots")
}

// ============================================================================
// Bounded Context: plugin-ecosystem (Epic-09)
// ============================================================================

model SkillPlugin {
  id             String @id @default(uuid())
  projectId      String @map("project_id")
  pluginSlug     String @map("plugin_slug")
  version        String
  lifecycleState String @default("DISCOVERED") @map("lifecycle_state")
  sourceRepoUrl  String @map("source_repo_url")
  manifestJson   String @default("{}") @map("manifest_json")
  updatedAt      BigInt @map("updated_at")

  @@unique([projectId, pluginSlug])
  @@map("skill_plugins")
}
